---
import "../styles/global.css";
import { site } from "../data/site.js";
const { title = `${site.name} — ${site.role}`, description = site.intro } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={Astro.site} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07080d" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9A%99%EF%B8%8F%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <script is:inline>
      // The loader only exists when JS can also remove it. Without this class
      // it is invisible, so a no-JS visitor never sees a curtain that never lifts.
      // Shown on a first visit or a refresh, and nowhere else:
      //  - back/forward returns skip it (nobody wants the curtain twice)
      //  - a deep link (/#work) skips it — that visitor asked for a section
      //  - reduced motion skips it
      // If the Navigation Timing API is missing, err towards showing it.
      const entry = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
      const firstOrReload = !entry || entry.type === "navigate" || entry.type === "reload";
      if (
        firstOrReload &&
        !location.hash &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("booting");
      }
    </script>

    <div id="boot" aria-hidden="true">
      <div class="boot-in">
        <svg viewBox="0 0 128 24" width="128" height="24" fill="none" aria-hidden="true">
          <path d="M16 12h48M64 12h48" stroke="var(--line)" stroke-width="1.5" />
          <circle class="bn n1" cx="16" cy="12" r="5" />
          <circle class="bn n2" cx="64" cy="12" r="5" />
          <circle class="bn n3" cx="112" cy="12" r="5" />
        </svg>
        <span class="boot-txt mono">compiling workflow…</span>
      </div>
    </div>

    <a href="#main" class="skip">Skip to content</a>
    <slot />

    <script is:inline>
      const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ── Loader: the fade is driven entirely by CSS, so it cannot be left
      // stuck by a stalled timer and cannot be cut short by the page loading
      // quickly — the sequence is the point, so it gets its full run. This
      // only drops the class afterwards, to stop the node animation.
      const doc = document.documentElement;
      if (doc.classList.contains("booting")) {
        setTimeout(() => doc.classList.remove("booting"), 2600);
      }

      // ── Scroll reveal. Without JS everything is already visible, because
      // .reveal only hides once this class is added.
      const els = document.querySelectorAll("[data-reveal]");
      if (rm || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        els.forEach((el) => el.classList.add("reveal"));
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }

      // ── Cursor-following spotlight. Pointer devices only, skipped under
      // reduced motion — it is decoration, not information.
      if (!rm && window.matchMedia("(hover: hover)").matches) {
        document.querySelectorAll("[data-spot]").forEach((card) => {
          card.addEventListener("pointermove", (e) => {
            const r = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${e.clientX - r.left}px`);
            card.style.setProperty("--my", `${e.clientY - r.top}px`);
          });
        });
      }

      // ── Workflow rail + nav scroll-spy. One rAF-throttled scroll handler
      // drives both: progress fill, node states, and the active nav link.
      const rail = document.querySelector("[data-rail-root]");
      const items = rail ? [...rail.querySelectorAll("li")] : [];
      const secs = items.map((li) => document.getElementById(li.dataset.rail));
      const navLinks = [...document.querySelectorAll('header nav a[href^="#"]')];

      let queued = false;
      const paint = () => {
        queued = false;
        const max = document.documentElement.scrollHeight - innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
        if (rail) rail.style.setProperty("--p", p);

        // Active = the section under the middle of the viewport. A "top passed
        // 40%" rule left the final node a ~70px window (and none at all with a
        // shorter footer), because the page stops scrolling before its top
        // reaches the line. The centre always lands inside some section.
        let idx = 0;
        secs.forEach((s, i) => {
          if (s && s.getBoundingClientRect().top <= innerHeight * 0.5) idx = i;
        });
        // At the end of the page the run is finished, whatever the centre says:
        // a short final section can sit entirely below the midpoint.
        if (max > 0 && scrollY >= max - 2) idx = items.length - 1;
        items.forEach((li, i) => {
          li.classList.toggle("done", i < idx);
          li.classList.toggle("now", i === idx);
        });
        const id = items[idx]?.dataset.rail;
        navLinks.forEach((a) => a.classList.toggle("active", a.getAttribute("href") === `#${id}`));
      };
      if (items.length) {
        addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
        addEventListener("resize", paint, { passive: true });
        paint();
      }
    </script>

    <style is:global>
      .skip {
        position: absolute; left: -9999px;
        background: var(--accent); color: #fff;
        padding: 10px 16px; border-radius: 8px; z-index: 100;
      }
      .skip:focus { left: 16px; top: 16px; }

      /* ── Loader ─────────────────────────────────────────────────────── */
      #boot {
        position: fixed; inset: 0; z-index: 999;
        display: grid; place-items: center;
        background: var(--bg);
        opacity: 0; visibility: hidden; pointer-events: none;
        transition: opacity .5s ease, visibility .5s;
      }
      .booting #boot {
        opacity: 1; visibility: visible;
        animation: curtain .5s ease 2s forwards;
      }
      @keyframes curtain { to { opacity: 0; visibility: hidden; } }

      .boot-in { display: grid; justify-items: center; gap: 18px; }
      .boot-txt { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); }

      /* nodes light up in sequence, like a run stepping through its graph */
      .bn { fill: var(--surface-2); stroke: var(--line); stroke-width: 1.5; }
      /* finite, so it stops on its own once the curtain is gone */
      .booting .bn { animation: fire 1s ease-in-out 3; }
      .booting .n2 { animation-delay: .2s; }
      .booting .n3 { animation-delay: .4s; }
      @keyframes fire {
        0%, 65%, 100% { fill: var(--surface-2); stroke: var(--line); }
        22%           { fill: var(--accent);    stroke: var(--accent); }
      }
    </style>
  </body>
</html>
